<?xml version="1.0" encoding="utf-8"?>
<!-- 车道领航专用设置页：入口在设置页顶部的"领航参数"按钮 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navSettingScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/navSettingContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- 设置分页入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnGotoGeneral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="通用参数"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGotoNav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="领航参数"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGotoOvertake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="42dp"
                android:minWidth="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="超车参数"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="车道领航设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- 所有开关一行排布，放不下自动换行（与通用设置页风格一致） -->
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:flexDirection="row"
            app:flexWrap="wrap">

            <CheckBox
                android:id="@+id/cbNavSettingAppNavi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="车道领航(高速)"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingAppRoadNavi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="车道领航(公路)"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingSuggestLane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="走推荐车道"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingDisLane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="避开禁行车道"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingKeepLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="提前靠左"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingKeepRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="提前靠右"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingVisionKeepRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="纯视觉提前靠右"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingSpeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="领航播报"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingSpeakFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="先播报后变道"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingBlindDecSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="盲区有车时减速"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingRoadMedian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="有隔离带(公路)"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingRightFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="优先从右计算车道(公路)"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingNavTurn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="领航转弯"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

            <CheckBox
                android:id="@+id/cbNavSettingLaneProb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="使用车道置信度"
                android:textSize="14sp"
                android:textColor="#000000"
                android:padding="0dp" />

        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="领航模式"
            android:textSize="14sp"
            android:textColor="#000000" />

        <RadioGroup
            android:id="@+id/rgNavSettingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbNavSettingFastMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="激进"
                android:textSize="14sp"
                android:textColor="#000000" />

            <RadioButton
                android:id="@+id/rbNavSettingNormalMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="标准"
                android:textSize="14sp"
                android:textColor="#000000"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbNavSettingSlowMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保守"
                android:textSize="14sp"
                android:textColor="#000000" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="车道领航最低车速(km/h)"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinusNaviMinSpeed"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavNaviMinSpeed"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="20"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusNaviMinSpeed"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="变道控制距离 高速/低速"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinusAtcDistH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavAtcDistH"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="2000"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusAtcDistH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMinusAtcDistL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavAtcDistL"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="500"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusAtcDistL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="分岔距离 高速/低速"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinusForkDistH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavForkDistH"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="80"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusForkDistH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMinusForkDistL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavForkDistL"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="30"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusForkDistL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbNavSettingRampSlowdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="16dp"
            android:text="匝道/分岔提前减速"
            android:textSize="14sp"
            android:textColor="#000000"
            android:padding="0dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="匝道提前距离(米) 高速/低速"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinusRampDistH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavRampDistH"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="800"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusRampDistH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMinusRampDistL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavRampDistL"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="300"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusRampDistL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="匝道目标限速(km/h) 高速/低速"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinusRampSpeedH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavRampSpeedH"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="80"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusRampSpeedH"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMinusRampSpeedL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavRampSpeedL"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="40"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusRampSpeedL"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="进入匝道后维持减速(秒)"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinusRampHold"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNavRampHold"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:inputType="number"
                android:gravity="center"
                android:text="10"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPlusRampHold"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveNavSetting"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="保存"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCancelNavSetting"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:text="返回"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
