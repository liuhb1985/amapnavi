<?xml version="1.0" encoding="utf-8"?>
<!-- 根容器用FrameLayout：超车诊断面板以悬浮方式显示，不占用原有布局空间，不影响其他按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="5dp"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="5dp"
    android:id="@+id/containerLinearLayout">

    <!-- 顶部环形速度显示栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- 左边圆圈 -->
        <LinearLayout
            android:id="@+id/speed_left"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ring_green"
            android:layout_marginEnd="8dp">  <!-- 左边圆圈与中间区域间距 -->

            <TextView
                android:id="@+id/tvSpeedLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#00C853"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 中间区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNavInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#666666"
                android:text="导航信息"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:textSize="15sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <!-- 两个文本框之间间距 -->
            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#666666"
                android:text="000 m"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:textSize="15sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- 右边圆圈 -->
        <LinearLayout
            android:id="@+id/speed_right"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ring_red"
            android:layout_marginStart="8dp">  <!-- 右边圆圈与中间区域间距 -->

            <TextView
                android:id="@+id/tvSpeedRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FF0000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/tvUdpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导航: 需要导航功能请打开高德车机版并开启导航"
            android:textSize="12sp"
            android:textColor="#0000FF"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#0000FF"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/tvDevicID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: "
            android:textSize="12sp"
            android:textColor="#0000FF"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vLaneTextViewLayout"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/driveWayTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#0000FF"/>

        <Space
            android:id="@+id/driveWaySpacer"
            android:layout_width="12dp"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/vLaneTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#0000FF"/>
    </LinearLayout>

    <!-- 三按钮独立一行：设置 / 超车 / 设备 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutThreeButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- 超车：打开全屏超车诊断页 -->
        <Button
            android:id="@+id/btnOvertakeDebug"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:text="超车"
            android:textSize="14sp"
            android:background="@drawable/btn_blue"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSetting"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <!-- 原“超车功能”按钮(webView控制)，按需求隐藏，保留控件以免代码引用报错 -->
        <Button
            android:id="@+id/btnAppOverTake"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone"
            android:text="超车功能"
            android:textSize="14sp"
            android:background="@drawable/btn_blue"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnSetting"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:text="设置"
            android:textSize="14sp"
            android:background="@drawable/btn_green"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toEndOf="@id/btnOvertakeDebug"
            app:layout_constraintEnd_toStartOf="@id/btnNavSetting"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <Button
            android:id="@+id/btnNavSetting"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:text="OP参数"
            android:textSize="14sp"
            android:background="@drawable/btn_blue"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toEndOf="@id/btnSetting"
            app:layout_constraintEnd_toStartOf="@id/btnScanDevice"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <Button
            android:id="@+id/btnScanDevice"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:text="设备"
            android:textSize="14sp"
            android:background="@drawable/btn_yellow"
            android:textColor="#000000"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toEndOf="@id/btnNavSetting"
            app:layout_constraintEnd_toStartOf="@id/btnPay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <Button
            android:id="@+id/btnPay"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:text="赞助"
            android:textSize="14sp"
            android:background="@drawable/btn_red"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toEndOf="@id/btnScanDevice"
            app:layout_constraintEnd_toStartOf="@id/btnMoreButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <!-- 最右侧：紧凑 >> 按钮 -->
        <Button
            android:id="@+id/btnMoreButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minHeight="30dp"
            android:minWidth="0dp"
            android:text=">>"
            android:textSize="14sp"
            android:textColor="#000000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/btn_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layoutSystemButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- ============ 第一行：安装 / 测试 ============ -->
        <LinearLayout
            android:id="@+id/installTestRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Flask -->
            <Button
                android:id="@+id/btnInstallFlask"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.4"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="安装Flask"
                android:textSize="15sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/btn_green"
                android:textColor="#FFFFFF" />

            <!-- OpenCV -->
            <Button
                android:id="@+id/btnInstallOpencv"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="CV2"
                android:textSize="15sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/btn_green"
                android:textColor="#FFFFFF" />

            <!-- 车道线测试：打开车道线推理测试页（真机验证 ONNX 推理是否正常） -->
            <Button
                android:id="@+id/btnLaneTest"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.3"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="车道线测试"
                android:textSize="15sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/btn_yellow"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- ============ 三个大按钮：从安装行下方一直铺到面板底部，高度按权重平分 ============
             面板高度由 applyRoadLimitPanelHeight() 在展开时算成「内容区高度的80%」，底部留约20%；
             按钮宽度取屏宽70%并水平居中，高度按 weight 平分，间距 14dp，方便行驶中盲按 -->
        <LinearLayout
            android:id="@+id/roadLimitGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/installTestRow"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 限速 +5 -->
            <Button
                android:id="@+id/btnIncRoadLimit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="限速 +5"
                android:textSize="26sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:background="@drawable/btn_blue"
                android:textColor="#FFFFFF" />

            <!-- 重置：按钮上显示当前实际偏移量（由 refreshRoadLimitBtnUi() 刷新） -->
            <Button
                android:id="@+id/btnResetRoadLimit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="重置（当前偏移 0）"
                android:textSize="21sp"
                android:includeFontPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:background="@drawable/btn_red"
                android:textColor="#FFFFFF" />

            <!-- 限速 -5 -->
            <Button
                android:id="@+id/btnDecRoadLimit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="限速 -5"
                android:textSize="26sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:background="@drawable/btn_blue"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- android:visibility="gone" -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="8dp">


        <Button
            android:id="@+id/btnTbtTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="导航引导测试"/>
    </LinearLayout>

    <!--
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/tvCameraInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相机信息: "
            android:textSize="12sp"
            android:textColor="#0000FF"/>

        <TextureView
            android:id="@+id/texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
    -->

    <LinearLayout
        android:id="@+id/imageViewLinear"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvServerData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备: "
            android:textSize="12sp"
            android:textColor="#0000FF"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnShowLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日志"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnExportLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导出"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvNavData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导航: "
            android:textSize="12sp"
            android:textColor="#0000FF"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnNavState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="概览"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvCpData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="状态: "
            android:textSize="12sp"
            android:textColor="#0000FF"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复制"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground" />


    </LinearLayout>

    <!-- 导航日志 -->
    <ScrollView
        android:id="@+id/scrollRawLogNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/rawLogNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#000000"
            android:scrollbars="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/webLinearLayout"
        android:orientation="vertical">

        <!-- WebView，初始隐藏 -->
        <WebView
            android:id="@+id/webViewSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:background="#EEEEEE" />

        <!-- 日志区域 -->
        <ScrollView
            android:id="@+id/scrollRawLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:visibility="gone"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/rawLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#000000"
                android:scrollbars="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>

    <!-- 超车诊断页：铺满整个界面，默认隐藏，关闭后完全恢复原界面 -->
    <LinearLayout
        android:id="@+id/layoutOvertakeDebug"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#FAFDFDF7"
        android:elevation="8dp"
        android:padding="6dp">

        <!-- 顶部：阶段/结论 + 关闭 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvOvertakeDebugHead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#D84315"
                android:maxLines="1"
                android:ellipsize="end"/>

            <Button
                android:id="@+id/btnOvertakeSetting"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:text="设置"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_green"/>

            <Button
                android:id="@+id/btnOvertakeDebugClose"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="关闭"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_blue"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 超车页雷达示意图（4 行，中列较窄）：
                     [原车前雷达] [正前车] [原车前雷达]     <- 左右列上下两格合计高度 = 正前车卡片
                     [激光前目标] [正前车] [激光前目标]
                     [激光后目标] [ 本 车 ] [激光后目标]
                     [禁止变道+原因]    [禁止变道+原因]
                     前 3 行只显示雷达数据；能否变道只放在第 4 行 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tvRadarMmwLeft"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="3dp"
                            android:padding="4dp"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:background="#EEEEEE"
                            android:text="原车雷达"/>

                        <TextView
                            android:id="@+id/tvRadarLidarLeftFront"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="3dp"
                            android:padding="4dp"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:background="#EEEEEE"
                            android:text="激光前"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRadarFront"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_weight="0.55"
                        android:layout_margin="3dp"
                        android:padding="4dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textColor="#757575"
                        android:background="#EEEEEE"
                        android:text="正前车"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tvRadarMmwRight"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="3dp"
                            android:padding="4dp"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:background="#EEEEEE"
                            android:text="原车雷达"/>

                        <TextView
                            android:id="@+id/tvRadarLidarRightFront"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_margin="3dp"
                            android:padding="4dp"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:background="#EEEEEE"
                            android:text="激光前"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 第三行：激光后目标 - 本车 - 激光后目标 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/tvRadarLidarLeftRear"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:padding="4dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textColor="#757575"
                        android:background="#EEEEEE"
                        android:text="激光后"/>

                    <TextView
                        android:id="@+id/tvRadarEgo"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="0.55"
                        android:layout_margin="3dp"
                        android:padding="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#37474F"
                        android:text="自车"/>

                    <TextView
                        android:id="@+id/tvRadarLidarRightRear"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:padding="4dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textColor="#757575"
                        android:background="#EEEEEE"
                        android:text="激光后"/>
                </LinearLayout>

                <!-- 第四行：左/右 是否禁止变道与原因（各占半屏宽） -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/tvRadarLeftBlock"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:padding="4dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textColor="#757575"
                        android:background="#EEEEEE"
                        android:text="左变道"/>

                    <TextView
                        android:id="@+id/tvRadarRightBlock"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:padding="4dp"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textColor="#757575"
                        android:background="#EEEEEE"
                        android:text="右变道"/>
                </LinearLayout>

                <!-- 决策详情 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="— 决策详情(点击可复制) —"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvOvertakeDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="2dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- 页脚：超车专用日志(独立文件) 记录开关 + 导出 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvOvertakeLogState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="超车日志:未记录"
                android:textSize="12sp"
                android:textColor="#666666"
                android:maxLines="1"
                android:ellipsize="middle"/>

            <Button
                android:id="@+id/btnOvertakeLogToggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:text="记录"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_blue"/>

            <Button
                android:id="@+id/btnOvertakeLogShare"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="发日志"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_green"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
